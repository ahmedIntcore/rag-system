# =============================================================
# .env.example — copy to .env and fill in your real values
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit your .env file! Add it to .gitignore.
# =============================================================

# --- Anthropic Claude AI ---
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- Google Sheets ---
# Found in your Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# --- Google Drive ---
# Optional: folder to read documents from and store backups
# https://drive.google.com/drive/folders/THIS_IS_THE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# --- Google Credentials ---
# Path to your service account key JSON file
# Download from: Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_CREDENTIALS_PATH=credentials.json

# --- Server ---
PORT=3000
